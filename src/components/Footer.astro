---
import Mark from './Mark.astro';
const year = new Date().getFullYear();
---
<footer class="footer on-dark">
  <div class="wrap">
    <div class="big" data-reveal>
      <Mark size={88} />
      <p class="word" aria-hidden="true">Manora<span class="serif">Live</span></p>
    </div>

    <div class="cols">
      <div>
        <p class="t">Manora Photobooth</p>
        <p>Location de bornes photo au Puy-en-Velay : mariages, anniversaires, soirées d'entreprise.</p>
      </div>
      <div>
        <p class="t">Le site</p>
        <ul>
          <li><a href="/#parcours">Comment ça marche</a></li>
          <li><a href="/#capteurs">Capteurs et règles</a></li>
          <li><a href="/#architecture">Sous le capot</a></li>
          <li><a href="/installation">Installer la borne</a></li>
        </ul>
      </div>
      <div>
        <p class="t">Le projet</p>
        <p>SAÉ fil rouge IoT · BUT MMI 3, parcours DW<br />IUT Clermont Auvergne, site du Puy-en-Velay</p>
      </div>
    </div>

    <div class="legal">
      <span>© {year} Manora · Théo Manya</span>
      <span>Ce site ne dépose aucun cookie et charge ses polices en local.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: rgba(255, 250, 241, .72);
    padding: 90px 0 36px;
    overflow: hidden;
    font-size: 15px;
  }
  .big {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
    padding-bottom: 60px;
    border-bottom: 1px solid rgba(255, 250, 241, .12);
  }
  .big :global(svg) { flex-shrink: 0; width: clamp(56px, 9vw, 88px); height: auto; }
  .word {
    font-size: clamp(52px, 12vw, 160px);
    font-weight: 800;
    letter-spacing: -.05em;
    line-height: .9;
    color: var(--cream-2);
  }
  .word .serif { color: var(--coral); margin-left: .18em; }

  .cols {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.3fr;
    gap: 40px;
    padding: 50px 0;
  }
  .t {
    color: #fff;
    font-weight: 800;
    margin-bottom: 12px;
  }
  ul { list-style: none; display: grid; gap: 6px; }
  a { text-decoration: none; transition: color .3s; }
  a:hover { color: var(--coral-light); }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    font-size: 13px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 250, 241, .12);
  }

  @media (max-width: 760px) {
    .cols { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
