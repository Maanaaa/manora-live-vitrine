---
/**
 * Le pictogramme du logo Manora (l'appareil photo souriant), redessiné en SVG
 * pour pouvoir l'animer : il cligne, regarde autour de lui, et ses rayons flashent.
 */
interface Props {
  size?: number | string;
  animated?: boolean;
  class?: string;
}
const { size = 140, animated = true, class: cls = '' } = Astro.props;
---
<svg
  class:list={['mark', { 'mark--live': animated }, cls]}
  width={size}
  height={size}
  viewBox="0 0 140 140"
  role="img"
  aria-label="Pictogramme Manora"
>
  <g class="mark__rays" stroke="#ff8d78" stroke-width="5" stroke-linecap="round">
    <line class="ray r1" x1="34" y1="3" x2="39" y2="15" />
    <line class="ray r2" x1="6" y1="26" x2="18" y2="32" />
    <line class="ray r3" x1="4" y1="52" x2="15" y2="51" />
  </g>
  <g class="mark__back">
    <rect x="42" y="44" width="86" height="86" rx="20" fill="#a1dacb" />
  </g>
  <g class="mark__front">
    <rect x="20" y="20" width="94" height="94" rx="22" fill="#ec5c46" />
    <circle cx="94" cy="38" r="7" fill="#fffffd" />
    <g class="mark__eye">
      <circle cx="58" cy="60" r="22" fill="#fffffd" />
      <g class="mark__pupil">
        <circle cx="58" cy="60" r="16.5" fill="#012b4f" />
        <circle cx="58" cy="60" r="9" fill="#0a3a66" />
        <circle cx="63.5" cy="54" r="4" fill="#5d86b0" />
      </g>
    </g>
    <path class="mark__smile" d="M42 92 Q60 106 80 92" fill="none" stroke="#fffffd" stroke-width="6.5" stroke-linecap="round" />
  </g>
</svg>

<style>
  .mark { overflow: visible; }
  .mark * { transform-box: fill-box; transform-origin: center; }

  .mark--live .mark__front { animation: float 6s ease-in-out infinite; }
  .mark--live .mark__back { animation: float 6s ease-in-out infinite reverse; }
  .mark--live .mark__eye { animation: blink 5s infinite; }
  .mark--live .mark__pupil { animation: look 9s var(--ease-out) infinite; }
  .mark--live .ray { animation: ray 2.4s var(--ease-out) infinite; transform-origin: right bottom; }
  .mark--live .r2 { animation-delay: .12s; }
  .mark--live .r3 { animation-delay: .24s; }
  .mark--live .mark__smile { animation: smile 9s ease-in-out infinite; }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(2px, -4px) rotate(-2deg); }
  }
  @keyframes blink {
    0%, 44%, 50%, 100% { transform: scaleY(1); }
    47% { transform: scaleY(.08); }
  }
  @keyframes look {
    0%, 12% { transform: translate(0, 0); }
    18%, 34% { transform: translate(-4px, 2px); }
    40%, 58% { transform: translate(4px, -2px); }
    64%, 100% { transform: translate(0, 0); }
  }
  @keyframes ray {
    0%, 55% { opacity: 1; transform: scale(1); }
    70% { opacity: .2; transform: scale(.4); }
    85% { opacity: 1; transform: scale(1.25); }
    100% { transform: scale(1); }
  }
  @keyframes smile {
    0%, 60%, 100% { d: path('M42 92 Q60 106 80 92'); }
    66%, 80% { d: path('M42 90 Q60 112 80 90'); }
  }
</style>
