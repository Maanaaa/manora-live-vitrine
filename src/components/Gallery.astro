---
import { Image } from 'astro:assets';
import Snap from './Snap.astro';
import borne from '../assets/photobooth-manora-mariage.jpg';
import borneEcran from '../assets/borne-ecran-mariage.jpg';

// Trois colonnes de tuiles, qui défilent dans des sens opposés
const cols = [
  [0, 'photo1', 3, 1, 5],
  [2, 4, 'photo2', 0, 3],
  [5, 1, 2, 'photo1', 4],
];
const hours = ['22', '23', '00'];
const label = (item: number | string, i: number) =>
  typeof item === 'string' || i % 2 === 0 ? 'Borne' : 'Invité';
---
<section class="section gallery">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow" data-reveal>Pour les invités</p>
      <h2 class="h2 split">Une galerie qui se remplit <span class="serif">pendant la fête.</span></h2>
      <p class="lead" data-reveal style="--d:200">
        Chaque photo prise par la borne arrive aussitôt sur les téléphones connectés. Les invités peuvent
        aussi ajouter les leurs, et supprimer celles qu'ils ont envoyées.
      </p>
      <ul class="points" data-reveal style="--d:300">
        <li><span>✓</span>Aucune appli à installer pour regarder : le QR code suffit</li>
        <li><span>✓</span>Galerie réservée aux invités de la soirée, grâce au QR code</li>
        <li><span>✓</span>Durée de conservation limitée, suppression par l'auteur</li>
      </ul>
    </div>

    <div class="wall" aria-hidden="true">
      {cols.map((col, ci) => (
        <div class:list={['col', `c${ci}`]}>
          <div class="belt">
            {[0, 1].map(() =>
              col.map((item, i) => (
                <figure class="tile">
                  {item === 'photo1' ? (
                    <Image src={borne} alt="" widths={[240, 400]} sizes="200px" />
                  ) : item === 'photo2' ? (
                    <Image src={borneEcran} alt="" widths={[240, 400]} sizes="200px" />
                  ) : (
                    <Snap variant={item as number} people={((item as number) % 3) + 1} />
                  )}
                  <figcaption>{label(item, i)} · {hours[ci]}:{String(10 + i * 9).padStart(2, '0')}</figcaption>
                </figure>
              )),
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery { background: var(--cream-2); overflow: hidden; }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
  }
  .h2 .serif { color: var(--coral); }
  .lead { margin-top: 22px; }
  .points { list-style: none; display: grid; gap: 12px; margin-top: 30px; font-weight: 600; }
  .points li { display: flex; gap: 12px; align-items: flex-start; }
  .points span {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--mint);
    color: var(--teal);
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 800;
    margin-top: 1px;
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    height: 640px;
    overflow: hidden;
    mask-image: linear-gradient(transparent, #000 15%, #000 85%, transparent);
    -webkit-mask-image: linear-gradient(transparent, #000 15%, #000 85%, transparent);
    transform: rotate(-4deg);
  }
  .belt { display: flex; flex-direction: column; gap: 14px; animation: gUp 30s linear infinite; }
  .c1 .belt { animation-name: gDown; animation-duration: 36s; }
  .c2 .belt { animation-duration: 26s; }
  .wall:hover .belt { animation-play-state: paused; }
  @keyframes gUp { to { transform: translateY(calc(-50% - 7px)); } }
  @keyframes gDown { from { transform: translateY(calc(-50% - 7px)); } to { transform: translateY(0); } }

  .tile {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-sm);
    transition: transform .5s var(--ease-spring);
  }
  .tile:hover { transform: scale(1.04) rotate(1deg); }
  .tile img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%; }
  .tile figcaption {
    position: absolute;
    left: 8px;
    bottom: 8px;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 99px;
    background: rgba(255, 254, 251, .9);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .wall { height: 460px; transform: rotate(-3deg) scale(1.05); }
  }
</style>
