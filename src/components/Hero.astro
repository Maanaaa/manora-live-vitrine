---
import { Image } from 'astro:assets';
import Mark from './Mark.astro';
import borne from '../assets/photobooth-manora-mariage.jpg';
import borneEcran from '../assets/borne-ecran-mariage.jpg';
---
<section class="hero">
  <div class="bg" aria-hidden="true">
    <span class="blob b1"></span>
    <span class="blob b2"></span>
    <span class="blob b3"></span>
  </div>

  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow" data-reveal>La borne photo Manora, version connectée</p>
      <h1 class="h1 split">Les photos de la soirée, <span class="serif accent">en direct.</span></h1>
      <p class="lead" data-reveal style="--d:500">
        Vos invités récupèrent leur photo en scannant un QR code, pendant la soirée.
        Et la borne se gère seule grâce à ses capteurs.
      </p>
      <div class="actions" data-reveal style="--d:650">
        <a href="#parcours" class="btn">
          Voir comment ça marche
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href="#demo" class="btn btn--ghost">
          <span class="play" aria-hidden="true"></span>
          La démo
        </a>
      </div>
      <ul class="badges" data-reveal style="--d:800">
        <li><span>1</span> QR code pour sa photo</li>
        <li><span>3</span> types d’appareils Zigbee</li>
        <li><span>30</span> jours de conservation des mesures</li>
      </ul>
    </div>

    <div class="visual" data-parallax>
      <div class="frame" data-depth="0.12">
        <Image src={borne} alt="La borne Manora installée dans une salle de réception en pierre" widths={[400, 640, 900]} sizes="(max-width: 900px) 90vw, 480px" loading="eager" fetchpriority="high" />
        <span class="flash" aria-hidden="true"></span>
      </div>

      <div class="mark-wrap" data-depth="0.9" aria-hidden="true"><Mark size={110} /></div>

      <div class="card c-presence" data-depth="0.5" aria-hidden="true">
        <span class="radar"><i></i><i></i></span>
        <div><b>Présence détectée</b><small>Décompte dans 3 s</small></div>
      </div>

      <div class="card c-remote" data-depth="0.3" aria-hidden="true">
        <span class="lamp-ic remote-ic">☀</span>
        <div><b>Borne réveillée</b><small>Un appui sur la télécommande</small></div>
      </div>

      <div class="card c-light" data-depth="0.4" aria-hidden="true">
        <span class="lamp-ic"><span></span></span>
        <div><b>Lumière allumée</b><small>Juste pour la photo</small></div>
      </div>

      <div class="phone" data-depth="0.7" aria-hidden="true">
        <div class="notif">
          <Image src={borneEcran} alt="" width={90} height={90} />
          <div><b>Votre photo est prête</b><small>Galerie du mariage · à l'instant</small></div>
        </div>
      </div>
    </div>
  </div>

  <a href="#probleme" class="scroll" aria-label="Défiler vers la suite">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 130px 0 90px;
    overflow: hidden;
    background: var(--cream-2);
  }

  .bg { position: absolute; inset: 0; pointer-events: none; }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: .7;
    animation: drift 18s ease-in-out infinite;
  }
  .b1 { width: 520px; height: 520px; background: var(--cream); top: -120px; left: -140px; }
  .b2 { width: 460px; height: 460px; background: rgba(169, 222, 210, .55); bottom: -160px; right: 8%; animation-delay: -6s; }
  .b3 { width: 300px; height: 300px; background: rgba(236, 92, 70, .18); top: 18%; right: -60px; animation-delay: -12s; }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(40px, -30px) scale(1.08); }
    66% { transform: translate(-30px, 20px) scale(.95); }
  }

  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
  }

  .h1 { margin-bottom: 26px; }
  .accent { color: var(--coral); white-space: nowrap; }

  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .play {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--coral);
    position: relative;
  }
  .play::after {
    content: "";
    position: absolute;
    left: 8px;
    top: 6px;
    border-left: 8px solid #fff;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }

  .badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin-top: 42px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .badges span {
    font-weight: 800;
    font-size: 20px;
    color: var(--ink);
    margin-right: 4px;
    letter-spacing: -.02em;
  }

  /* ── Visuel ── */
  .visual {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 480px;
    width: 100%;
    justify-self: center;
  }
  .visual > * { transition: translate .9s var(--ease-out); }

  .frame {
    position: absolute;
    inset: 0;
    border-radius: 240px 240px var(--radius) var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    animation: frameIn 1.4s var(--ease-out) both;
  }
  .frame img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  @keyframes frameIn {
    from { clip-path: inset(100% 0 0 0 round 240px 240px 22px 22px); }
    to { clip-path: inset(0 0 0 0 round 240px 240px 22px 22px); }
  }

  /* Le flash de la borne : même durée (6 s) que la notification, pour rester synchro */
  .flash {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 59% 13%, #fff 0%, rgba(255, 255, 255, .85) 12%, rgba(255, 250, 235, 0) 60%);
    opacity: 0;
    mix-blend-mode: screen;
    animation: flash 6s 1.6s infinite;
  }
  @keyframes flash {
    0%, 100% { opacity: 0; }
    2% { opacity: 1; }
    8% { opacity: 0; }
  }

  .mark-wrap {
    position: absolute;
    top: -26px;
    right: -34px;
    animation: pop .9s 1s var(--ease-spring) both;
  }

  .card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px 12px 12px;
    background: rgba(255, 254, 251, .92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(255, 255, 255, .7);
    font-size: 14px;
    line-height: 1.25;
    white-space: nowrap;
    animation: pop .8s var(--ease-spring) both;
  }
  .card b { display: block; font-weight: 800; }
  .card small { color: var(--muted); font-size: 12px; font-weight: 500; }

  @keyframes pop {
    from { opacity: 0; transform: translateY(20px) scale(.8); }
    to { opacity: 1; transform: none; }
  }

  .c-presence { top: 22%; left: -16%; animation-delay: 1.1s; }
  .radar {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--terracotta-soft);
    flex-shrink: 0;
  }
  .radar::after {
    content: "";
    position: absolute;
    inset: 13px;
    border-radius: 50%;
    background: var(--coral);
  }
  .radar i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--coral);
    animation: ripple 2s var(--ease-out) infinite;
  }
  .radar i + i { animation-delay: 1s; }
  @keyframes ripple {
    from { transform: scale(.3); opacity: 1; }
    to { transform: scale(1.5); opacity: 0; }
  }

  .c-remote { top: 48%; right: -14%; animation-delay: 1.3s; }
  .remote-ic { font-size: 18px; line-height: 1; color: var(--wood); }

  .c-light { top: 4%; left: 2%; animation-delay: 1.5s; }
  .lamp-ic {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--cream);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .lamp-ic span {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--sand);
    animation: heroLamp 6s 1.6s infinite;
  }
  /* même cycle de 6 s que le flash de la photo */
  @keyframes heroLamp {
    0%, 100% { background: var(--sand); box-shadow: none; }
    1%, 10% { background: var(--sun); box-shadow: 0 0 12px 3px rgba(232, 168, 56, .6); }
    14% { background: var(--sand); box-shadow: none; }
  }

  .phone {
    position: absolute;
    bottom: 6%;
    left: -20%;
    width: 270px;
  }
  .notif {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px;
    background: var(--ink);
    color: #fff;
    border-radius: 20px;
    box-shadow: var(--shadow);
    font-size: 14px;
    line-height: 1.3;
    animation: notif 6s 1.6s var(--ease-out) infinite both;
  }
  .notif img {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .notif b { display: block; }
  .notif small { color: var(--mint); font-size: 12px; }
  @keyframes notif {
    0%, 6% { opacity: 0; transform: translateY(30px) scale(.9); }
    14%, 86% { opacity: 1; transform: none; }
    96%, 100% { opacity: 0; transform: translateY(-10px) scale(.96); }
  }

  .scroll {
    position: absolute;
    bottom: 26px;
    left: 50%;
    width: 26px;
    height: 42px;
    margin-left: -13px;
    border: 2px solid var(--line-strong);
    border-radius: 99px;
  }
  .scroll span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    background: var(--coral);
    border-radius: 2px;
    animation: wheel 1.8s var(--ease-out) infinite;
  }
  @keyframes wheel {
    from { transform: translateY(0); opacity: 1; }
    to { transform: translateY(14px); opacity: 0; }
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .visual { max-width: 380px; margin-top: 20px; }
    .c-presence { left: -6%; }
    .c-remote { right: -6%; }
    .phone { left: -4%; width: 250px; }
    .mark-wrap { right: -10px; }
    .mark-wrap :global(svg) { width: 80px; height: 80px; }
    .scroll { display: none; }
  }
  @media (max-width: 480px) {
    .visual { max-width: 300px; }
    .card { font-size: 13px; padding: 9px 12px 9px 9px; }
    .c-presence { left: -4%; top: 26%; }
    .c-remote { right: -4%; }
    .phone { left: -2%; width: 230px; }
  }
</style>
