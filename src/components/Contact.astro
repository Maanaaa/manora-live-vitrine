---
import Mark from './Mark.astro';
import { site } from '../config';
const mail = `mailto:${site.contactEmail}?subject=${encodeURIComponent('Réservation de la borne Manora')}`;
---
<section class="contact" id="contact">
  <div class="wrap inner">
    <div class="marks" aria-hidden="true">
      <span class="m m1"><Mark size={90} /></span>
      <span class="m m2"><Mark size={60} animated={false} /></span>
      <span class="m m3"><Mark size={70} animated={false} /></span>
    </div>
    <p class="eyebrow" data-reveal>Mariage, anniversaire, soirée d'entreprise</p>
    <h2 class="h2 split">Votre soirée mérite <span class="serif">ses photos ce soir,</span> pas demain.</h2>
    <p class="lead" data-reveal style="--d:300">Manora loue ses bornes photo au Puy-en-Velay et alentours. Parlons de votre événement.</p>
    <div class="actions" data-reveal style="--d:450">
      <a href={mail} class="btn btn--light">
        Réserver la borne
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <span class="mail">{site.contactEmail}</span>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    background: var(--coral);
    color: #fff;
    padding-block: clamp(90px, 14vw, 170px);
    overflow: hidden;
    text-align: center;
  }
  .inner { position: relative; display: flex; flex-direction: column; align-items: center; }
  .eyebrow { color: var(--ink); }
  .eyebrow::before { background: var(--ink); }
  .h2 { max-width: 18ch; font-size: clamp(36px, 5.6vw, 72px); }
  .h2 .serif { color: var(--ink); }
  .lead { color: rgba(255, 255, 255, .9); margin-top: 22px; }
  .actions { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 36px; }
  .btn--light { --bg: #fff; --fg: var(--ink); padding: 18px 30px; font-size: 17px; }
  .btn--light::after { background: var(--ink); }
  .btn--light:hover { color: #fff; }
  .mail { font-weight: 600; opacity: .85; font-size: 15px; }

  .marks { position: absolute; inset: 0; pointer-events: none; }
  .m { position: absolute; opacity: .9; }
  /* Sur fond corail, le carré corail du picto passe en encre */
  .m :global(rect[fill="#ec5c46"]) { fill: var(--ink); }
  .m1 { top: -40px; left: 2%; animation: bob 7s ease-in-out infinite; }
  .m2 { bottom: 0; right: 4%; transform: rotate(14deg); animation: bob 6s -2s ease-in-out infinite; opacity: .5; }
  .m3 { top: 30%; right: 12%; transform: rotate(-10deg); animation: bob 8s -4s ease-in-out infinite; opacity: .35; }
  @keyframes bob { 50% { translate: 0 -16px; } }

  @media (max-width: 760px) {
    .m1 { top: -50px; left: -10px; }
    .m3 { display: none; }
  }
</style>
