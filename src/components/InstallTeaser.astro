---
const steps = [
  { t: 'Brancher', d: 'La borne, puis la lampe sur la prise connectée.' },
  { t: 'Allumer', d: 'Le Pi démarre et se connecte au serveur Manora.' },
  { t: 'Associer', d: 'La tablette scanne le QR de sa clé dans le back-office.' },
  { t: 'Profiter', d: 'Les capteurs sont prêts, la soirée peut commencer.' },
];
---
<section class="section install">
  <div class="wrap">
    <div class="top">
      <div>
        <p class="eyebrow" data-reveal>Installation</p>
        <h2 class="h2 split">Prête en <span class="serif">quatre gestes.</span></h2>
      </div>
      <a href="/installation" class="btn" data-reveal style="--d:200">
        Lire la documentation
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>

    <ol class="line" data-inview>
      <span class="rail" aria-hidden="true"><span></span></span>
      {steps.map((s, i) => (
        <li style={`--k:${i}`}>
          <span class="dot">{i + 1}</span>
          <b>{s.t}</b>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .install { background: var(--paper); }
  .top { display: flex; justify-content: space-between; align-items: flex-end; gap: 30px; flex-wrap: wrap; }
  .h2 .serif { color: var(--coral); }

  .line {
    position: relative;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 70px;
  }
  .rail {
    position: absolute;
    left: 28px;
    right: calc((100% - 72px) / 4 - 28px);
    top: 27px;
    height: 2px;
    background: var(--sand);
  }
  .rail span {
    position: absolute;
    inset: 0;
    background: var(--coral);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 2s var(--ease-out) .2s;
  }
  .is-in .rail span { transform: scaleX(1); }
  li { position: relative; }
  .dot {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--sand);
    font-weight: 800;
    font-size: 20px;
    margin-bottom: 18px;
    transition: background .4s, border-color .4s, color .4s, transform .6s var(--ease-spring);
    transition-delay: calc(var(--k) * 450ms + 200ms);
  }
  .is-in .dot { background: var(--coral); border-color: var(--coral); color: #fff; transform: scale(1.06); }
  li b { font-size: 20px; letter-spacing: -.02em; }
  li p { color: var(--ink-light); margin-top: 4px; font-size: 16px; }

  @media (max-width: 820px) {
    .line { grid-template-columns: 1fr; gap: 26px; }
    .rail { left: 27px; right: auto; top: 28px; bottom: 28px; width: 2px; height: auto; }
    .rail span { transform: scaleY(0); transform-origin: top; }
    .is-in .rail span { transform: scaleY(1); }
    li { padding-left: 80px; min-height: 56px; }
    .dot { position: absolute; left: 0; top: 0; margin: 0; }
  }
</style>
