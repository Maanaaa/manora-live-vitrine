---
const items = [
  'Photos en direct par QR code',
  'Se met en veille toute seule',
  'Quatre façons de lancer la photo',
  'Lumière allumée juste pour la photo',
  'Mesures gardées si la connexion coupe',
  'Galerie partagée avec les invités',
];
---
<div class="marquee on-dark">
  <p class="sr-only">{items.join(', ')}</p>
  <div class="track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul>
        {items.map((t) => (
          <li>{t}<span class="star">✦</span></li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    background: var(--ink);
    color: var(--cream-2);
    padding: 22px 0;
    overflow: hidden;
    transform: rotate(-1.2deg) scale(1.02);
    margin-block: -12px;
    position: relative;
    z-index: 2;
  }
  .track { display: flex; width: max-content; animation: scroll 38s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  ul { display: flex; list-style: none; }
  li {
    display: flex;
    align-items: center;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 700;
    letter-spacing: -.02em;
    white-space: nowrap;
  }
  .star { color: var(--sun); margin-inline: 28px; font-size: .8em; }
  li:nth-child(even) { color: var(--mint); }
  @keyframes scroll { to { transform: translateX(-50%); } }
</style>
