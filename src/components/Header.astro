---
const base = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { href: `${base}#parcours`, label: 'Comment ça marche' },
  { href: `${base}#capteurs`, label: 'Capteurs' },
  { href: `${base}#architecture`, label: 'Sous le capot' },
  { href: `${base}#technique`, label: 'Technique' },
  { href: `${base}#rgpd`, label: 'RGPD' },
  { href: `${base}#demo`, label: 'Démo' },
  { href: '/installation', label: 'Installation' },
];
---
<header class="header" data-header>
  <div class="bar wrap">
    <a href="/" class="brand" aria-label="Manora Live, accueil">
      <img src="/manora-photobooth-logo.webp" alt="" width="1000" height="290" />
      <span class="live"><span class="dot"></span>Live</span>
    </a>

    <nav class="nav" data-menu aria-label="Navigation principale">
      <ul>
        {links.map((l, i) => (
          <li style={`--i:${i}`}><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
      <a href={`${base}#contact`} class="btn btn--coral cta">Réserver la borne</a>
    </nav>

    <button class="burger" data-menu-toggle aria-expanded="false" aria-label="Ouvrir le menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-block: 14px;
    transition: transform .5s var(--ease-out), padding .4s var(--ease-out);
  }
  .header::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(255, 254, 251, .82);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity .4s;
  }
  .header.is-scrolled { padding-block: 8px; }
  .header.is-scrolled::before { opacity: 1; }
  .header.is-hidden { transform: translateY(-100%); }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand img { height: 40px; width: auto; transition: height .4s var(--ease-out); }
  .is-scrolled .brand img { height: 34px; }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--ink);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 5px 10px 5px 8px;
    border-radius: 99px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 0 rgba(236, 92, 70, .7);
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 7px rgba(236, 92, 70, 0); }
    100% { box-shadow: 0 0 0 0 rgba(236, 92, 70, 0); }
  }

  .nav { display: flex; align-items: center; gap: 28px; }
  .nav ul { display: flex; gap: 26px; list-style: none; }
  .nav ul a {
    position: relative;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-light);
    padding-block: 6px;
  }
  .nav ul a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--coral);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .4s var(--ease-out);
  }
  .nav ul a:hover::after { transform: scaleX(1); transform-origin: left; }
  .cta { padding: 12px 20px; font-size: 15px; }

  .burger { display: none; width: 44px; height: 44px; position: relative; border-radius: 50%; background: var(--ink); }
  .burger span {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform .4s var(--ease-out);
  }
  .burger span:first-child { transform: translateY(-4px); }
  .burger span:last-child { transform: translateY(4px); }
  .is-open .burger span:first-child { transform: rotate(45deg); }
  .is-open .burger span:last-child { transform: rotate(-45deg); }

  @media (max-width: 1020px) {
    .burger { display: block; z-index: 2; }
    .nav {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 40px;
      padding: 100px var(--gutter) 40px;
      background: var(--cream-2);
      clip-path: circle(0 at calc(100% - var(--gutter) - 22px) 36px);
      transition: clip-path .7s var(--ease-out);
      visibility: hidden;
    }
    .is-open .nav { clip-path: circle(150% at calc(100% - var(--gutter) - 22px) 36px); visibility: visible; }
    .nav ul { flex-direction: column; gap: 8px; }
    .nav ul a { font-size: clamp(30px, 8vw, 44px); font-weight: 800; letter-spacing: -.03em; color: var(--ink); }
    .nav ul li {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity .5s, transform .6s var(--ease-out);
      transition-delay: calc(var(--i) * 60ms + 150ms);
    }
    .is-open .nav ul li { opacity: 1; transform: none; }
    .brand { z-index: 2; position: relative; }
  }
  @media (max-width: 420px) {
    .brand img { height: 32px; }
  }
</style>
